classDiagram
    %% PawPal+ design: owner/pet/task model feeding a constraint-based daily scheduler.

    class Owner {
        +str name
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task_id: str) None
    }

    class Task {
        +str id
        +str title
        +int duration_minutes
        +Priority priority
        +bool is_recurring
        +str recurrence_pattern
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Scheduler {
        +int available_minutes
        +generate_plan(pet: Pet, available_minutes: int) DailyPlan
        -sort_tasks(tasks: list~Task~) list~Task~
        -select_within_time(tasks: list~Task~, available_minutes: int) list~Task~
        -resolve_conflicts(tasks: list~Task~) list~Task~
    }

    class DailyPlan {
        +date plan_date
        +Pet pet
        +list~ScheduledTask~ items
        +add_item(item: ScheduledTask) None
        +total_time() int
        +explain() str
    }

    class ScheduledTask {
        +Task task
        +time start_time
        +time end_time
        +str reason
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Task "1" --> "1" Priority : priority
    Scheduler ..> Pet : reads tasks from
    Scheduler --> DailyPlan : creates
    DailyPlan "1" o-- "*" ScheduledTask : contains
    ScheduledTask --> Task : references
